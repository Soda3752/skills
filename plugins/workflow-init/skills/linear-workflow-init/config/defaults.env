# linear-workflow-init 預設值
#
# 這是你唯一需要手動編輯的檔案。init 讀這裡當預設值帶入問答，
# 最後把「該專案實際採用的值」寫進該專案的 .claude/linear-workflow.json。
#
# 改這裡只影響「未來接的新專案」，不會回頭動已經設定好的專案。
# 要改已設定專案，直接編輯該專案的 .claude/linear-workflow.json。
#
# ⚠️ 第一次使用請至少改掉 DEFAULT_TEAM。狀態名稱不改也沒關係，
#    init 會用 list_issue_statuses 實查校正。

# ── Workspace / Team ─────────────────────────────
# Linear 的層級是 Workspace → Team → Issue。沒有 Jira 那種站台 hostname，
# MCP 連的就是你授權時選的 workspace，所以這裡不需要填站台。
#
# Team 才是票的歸屬單位（票號前綴由它決定，例如 PROJ team → PROJ-1）。
DEFAULT_TEAM=your-team

# ── 狀態欄名稱 ───────────────────────────────────
# 六個核心 key 是工作流的骨架，不要增減——規則檔只認得這六個。
#
# 與 Jira 版最大的差異：Linear 沒有 transition id，狀態轉換沒有圖，
# 任何狀態都能直接轉到任何狀態。所以這裡填的是「狀態欄顯示名稱」，
# init 實查後會把對應的 state UUID 一併寫進設定檔。
#
# Linear 新 team 的預設欄位只有 Backlog / Todo / In Progress / Done /
# Canceled / Duplicate——下面的 In Review、Blocked、API Require 三欄
# 需要你自己去 Linear 建（Settings → Team → Workflow）。init 會偵測缺哪幾欄。
STATE_NAME_TODO=Todo
STATE_NAME_INPROGRESS=In Progress
STATE_NAME_INREVIEW=In Review
STATE_NAME_BLOCK=Blocked
STATE_NAME_APIREQUIRE=API Require
STATE_NAME_DONE=Done

# 上面對不到時的備用名稱（你的 team 用了不同叫法才需要填）。
STATE_ALTNAME_BLOCK=Block
STATE_ALTNAME_APIREQUIRE=Waiting for API
STATE_ALTNAME_INREVIEW=審核中

# 建立缺欄時建議的 statusType。Linear 的 type 只有這六種：
# backlog / unstarted / started / completed / canceled / duplicate
#
# In Review 要用 started（它在進行中之後、代表工作仍在流動）；
# Blocked 與 API Require 用 unstarted（票停住了，不該算進「正在做」的統計）。
# 這個選擇會影響 Linear 的 cycle 進度圖與 statusType 判準，不是純美觀。
SUGGEST_TYPE_INREVIEW=started
SUGGEST_TYPE_BLOCK=unstarted
SUGGEST_TYPE_APIREQUIRE=unstarted

# ── 容器 ─────────────────────────────────────────
# Jira Epic 在這套 Linear 版對應到 Linear Project。
# project = 用 Linear Project 分組（有進度條、milestone、status update）
# parent  = 用父議題 + 子議題分組
CONTAINER_MODE=project

# ── 慣例 ─────────────────────────────────────────
# 推到 API Require 時一併掛上的 label，讓後端缺口票能用 label 聚合查詢。
API_REQUIRE_LABEL=api-require

# 從 git 分支名抽票號用的 regex。
#
# Linear 每張票自帶一個建議分支名（欄位 gitBranchName），形狀像
# your-name/proj-1-get-familiar-with-linear——注意票號那段是**小寫**的。
# 所以抽出來之後一定要轉大寫再拿去比對，否則 proj-1 對不上 PROJ-1。
BRANCH_TICKET_PATTERN=([A-Za-z]+-[0-9]+)

# 註解與報告語言。實作紀錄註解一律用這個語言寫。
COMMENT_LANGUAGE=繁體中文
