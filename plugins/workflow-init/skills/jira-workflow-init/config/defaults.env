# jira-workflow-init 預設值
#
# 這是你唯一需要手動編輯的檔案。init 讀這裡當預設值帶入問答，
# 最後把「該專案實際採用的值」寫進該專案的 .claude/jira-workflow.json。
#
# 改這裡只影響「未來接的新專案」，不會回頭動已經設定好的專案。
# 要改已設定專案，直接編輯該專案的 .claude/jira-workflow.json。
#
# ⚠️ 這份檔案裡的值都是範例。第一次使用請至少改掉 JIRA_SITE 與
#    DEFAULT_PROJECT_KEY；transition id 不改也沒關係，init 會實查校正。

# ── 站台 ─────────────────────────────────────────
# Atlassian 站台 hostname。MCP 的 cloudId 參數直接吃這個形式，不需轉 UUID。
JIRA_SITE=your-site.atlassian.net

# ── 專案 ─────────────────────────────────────────
# init 會列出站台上可見的 project 讓使用者挑，這個值排第一位並標為預設。
DEFAULT_PROJECT_KEY=PROJ

# ── Transition id ────────────────────────────────
# 這些是 workflow scheme 綁定的，換 project 可能整組不同。
# init 會實查校正（做法見 SKILL.md § transition 校正）。
#
# 注意：下面這六個值是某一個實際 project（以下稱 PROJ）的，不是站台通用值。
# 換 project 不只是「可能不同」——實測另一個 project（ACME）的 21=待辦事項、31=進行中、41=完成，
# 與下面的 21=進行中、31=審核中、41=Block 整組錯開。也就是說沿用這裡的值到別的
# project，很可能不是「查不到」而是「推到錯的欄」。
# 所以 init 沿用前會做撞號檢查，撞號一律寫 null（見 SKILL.md § 沿用 env 之前必須撞號檢查）。
#
# 這六個 key 是工作流的核心，不要增減——規則檔只認得這六個。
# 專案若有第七、第八個狀態欄（實例：PROJ 有一欄 PENDING），init 會探測到並記錄在
# jira-workflow.json 的 extraStatuses，但工作流不會自動推到那些狀態。
TRANSITION_TODO=11
TRANSITION_INPROGRESS=21
TRANSITION_INREVIEW=31
TRANSITION_BLOCK=41
TRANSITION_APIREQUIRE=2
TRANSITION_DONE=51

# 狀態欄的顯示名稱，用來把實查結果對回上面的 key。
#
# 注意：transition 的 name 與它目標狀態的 name 可能不同。PROJ 的例子是
# transition name = "In Review" 而狀態欄實際顯示「審核中」。
# 比對時以目標狀態 to.name 為主、transition name 為輔，兩邊任一命中都算對到。
# 所以這裡兩種寫法都可以填，填你在看板上看到的那個比較直覺。
STATUS_NAME_TODO=待辦事項
STATUS_NAME_INPROGRESS=進行中
STATUS_NAME_INREVIEW=審核中
STATUS_NAME_BLOCK=Block
STATUS_NAME_APIREQUIRE=API Require
STATUS_NAME_DONE=完成

# 上面對不到時的備用名稱（transition name 與狀態名不同的欄位才需要填）。
STATUS_ALTNAME_INREVIEW=In Review

# ── 慣例 ─────────────────────────────────────────
# 推到 API Require 時一併掛上的 label，讓後端缺口票能用 label 聚合查詢。
API_REQUIRE_LABEL=api-require

# 從 git 分支名抽票號用的 regex。預設吃 fix/proj-8-9-xxx 與 feature/PROJ-49-xxx 兩種。
BRANCH_TICKET_PATTERN=([A-Za-z]+-[0-9]+)

# 註解與報告語言。實作紀錄註解一律用這個語言寫。
COMMENT_LANGUAGE=繁體中文
